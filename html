    <script>
        (function() {
            'use strict';

            // =================================================================
            // 1. DATA PRODUK (6 item fashion)
            // =================================================================
            const products = [{
                id: 1,
                name: 'Floral Maxi Dress',
                desc: 'Gaun panjang motif bunga, bahan katun adem.',
                price: 285000,
                image: 'https://images.unsplash.com/photo-1595777457583-95e059d581b8?w=400&h=400&fit=crop&auto=format'
            }, {
                id: 2,
                name: 'Classic Oxford Shirt',
                desc: 'Kemeja putih klasik, cocok untuk segala acara.',
                price: 175000,
                image: 'https://images.unsplash.com/photo-1598033129183-c4f50c736f10?w=400&h=400&fit=crop&auto=format'
            }, {
                id: 3,
                name: 'Slim Fit Jeans',
                desc: 'Jeans stretch slim fit dengan warna denim gelap.',
                price: 245000,
                image: 'https://images.unsplash.com/photo-1541099649105-f69ad21f3246?w=400&h=400&fit=crop&auto=format'
            }, {
                id: 4,
                name: 'Denim Jacket',
                desc: 'Jaket denim klasik dengan detail distressed.',
                price: 325000,
                image: 'https://images.unsplash.com/photo-1551537482-f2075a1d41f2?w=400&h=400&fit=crop&auto=format'
            }, {
                id: 5,
                name: 'Pleated Skirt',
                desc: 'Rok lipit midi dengan warna earth tone.',
                price: 195000,
                image: 'https://images.unsplash.com/photo-1583496661160-fb5886a0aaaa?w=400&h=400&fit=crop&auto=format'
            }, {
                id: 6,
                name: 'Leather Tote Bag',
                desc: 'Tote bag kulit asli dengan ruang penyimpanan luas.',
                price: 155000,
                image: 'https://images.unsplash.com/photo-1591561954555-48ed7addfcd5?w=400&h=400&fit=crop&auto=format'
            }];

            // =================================================================
            // 2. STATE
            // =================================================================
            let cart = []; // { id, name, price, image, quantity }
            let currentDiscount = 0; // 0–50
            let isSpinning = false;
            let orderCounter = parseInt(localStorage.getItem('lunaOrderCounter')) || 0;
            let wheelRotation = 0; // derajat kumulatif

            // =================================================================
            // 3. DOM REFS
            // =================================================================
            const productGrid = document.getElementById('productGrid');
            const cartBody = document.getElementById('cartBody');
            const cartTotal = document.getElementById('cartTotal');
            const cartBadge = document.getElementById('cartBadge');
            const cartIcon = document.getElementById('cartIcon');
            const cartOverlay = document.getElementById('cartOverlay');
            const cartSidebar = document.getElementById('cartSidebar');
            const cartClose = document.getElementById('cartClose');
            const btnCheckout = document.getElementById('btnCheckout');
            const paymentModal = document.getElementById('paymentModal');
            const pmClose = document.getElementById('pmClose');
            const btnSpin = document.getElementById('btnSpin');
            const wheelCanvas = document.getElementById('wheelCanvas');
            const discountDisplay = document.getElementById('discountDisplay');
            const pmSummary = document.getElementById('pmSummary');
            const btnPay = document.getElementById('btnPay');
            const successModal = document.getElementById('successModal');
            const orderNumber = document.getElementById('orderNumber');
            const btnSuccessClose = document.getElementById('btnSuccessClose');
            const toastContainer = document.getElementById('toastContainer');
            const hamburger = document.getElementById('hamburger');
            const mainNav = document.getElementById('mainNav');

            // =================================================================
            // 4. RENDER PRODUK
            // =================================================================
            function renderProducts() {
                productGrid.innerHTML = '';
                products.forEach(p => {
                    const card = document.createElement('div');
                    card.className = 'product-card';
                    card.innerHTML = `
                <div class="img-wrap">
                  <img src="${p.image}" alt="${p.name}" loading="lazy" />
                </div>
                <div class="info">
                  <h3>${p.name}</h3>
                  <div class="desc">${p.desc}</div>
                  <div class="price">Rp ${p.price.toLocaleString('id-ID')}</div>
                  <button class="btn-add" data-id="${p.id}">+ Tambah ke Keranjang</button>
                </div>
              `;
                    productGrid.appendChild(card);
                });

                // Event listener tombol tambah
                document.querySelectorAll('.btn-add').forEach(btn => {
                    btn.addEventListener('click', function(e) {
                        const id = parseInt(this.dataset.id);
                        const product = products.find(p => p.id === id);
                        if (product) addToCart(product);
                    });
                });
            }

            // =================================================================
            // 5. KERANJANG — CRUD + localStorage
            // =================================================================
            function loadCart() {
                try {
                    const stored = localStorage.getItem('lunaCart');
                    if (stored) cart = JSON.parse(stored);
                    else cart = [];
                } catch (_) { cart = []; }
                // validasi
                cart = cart.filter(item => item && typeof item === 'object' && item.id);
                renderCart();
            }

            function saveCart() {
                localStorage.setItem('lunaCart', JSON.stringify(cart));
                updateBadge();
                updateTotal();
            }

            function addToCart(product) {
                const existing = cart.find(item => item.id === product.id);
                if (existing) {
                    existing.quantity += 1;
                } else {
                    cart.push({
                        id: product.id,
                        name: product.name,
                        price: product.price,
                        image: product.image,
                        quantity: 1
                    });
                }
                saveCart();
                renderCart();
                showToast(`✅ ${product.name} ditambahkan!`, 'success');
                // animasi badge
                cartBadge.classList.remove('pop');
                void cartBadge.offsetWidth;
                cartBadge.classList.add('pop');
            }

            function removeFromCart(id) {
                cart = cart.filter(item => item.id !== id);
                saveCart();
                renderCart();
            }

            function updateQuantity(id, delta) {
                const item = cart.find(i => i.id === id);
                if (!item) return;
                const newQty = item.quantity + delta;
                if (newQty <= 0) {
                    removeFromCart(id);
                    return;
                }
                item.quantity = newQty;
                saveCart();
                renderCart();
            }

            function getTotalItems() {
                return cart.reduce((sum, i) => sum + i.quantity, 0);
            }

            function getTotalPrice() {
                return cart.reduce((sum, i) => sum + i.price * i.quantity, 0);
            }

            function updateBadge() {
                const total = getTotalItems();
                cartBadge.textContent = total;
                cartBadge.style.display = total > 0 ? 'flex' : 'none';
            }

            function updateTotal() {
                const total = getTotalPrice();
                cartTotal.textContent = `Rp ${total.toLocaleString('id-ID')}`;
            }

            function renderCart() {
                const body = cartBody;
                if (cart.length === 0) {
                    body.innerHTML = `
                <div class="cart-empty">
                  <span>🛒</span>
                  Keranjang kosong.<br />Yuk, pilih koleksi favoritmu!
                </div>
              `;
                    btnCheckout.disabled = true;
                    updateTotal();
                    return;
                }

                let html = '';
                cart.forEach(item => {
                    const subtotal = item.price * item.quantity;
                    html += `
                <div class="cart-item">
                  <img class="ci-img" src="${item.image}" alt="${item.name}" loading="lazy" />
                  <div class="ci-info">
                    <div class="ci-name">${item.name}</div>
                    <div class="ci-price">Rp ${item.price.toLocaleString('id-ID')}</div>
                    <div class="ci-qty">
                      <button data-id="${item.id}" data-delta="-1">−</button>
                      <span>${item.quantity}</span>
                      <button data-id="${item.id}" data-delta="1">+</button>
                      <span style="margin-left:8px; font-weight:600;">Rp ${subtotal.toLocaleString('id-ID')}</span>
                    </div>
                  </div>
                  <button class="ci-remove" data-id="${item.id}" aria-label="Hapus">✕</button>
                </div>
              `;
                });
                body.innerHTML = html;

                // Event listeners untuk qty & hapus
                body.querySelectorAll('.ci-qty button').forEach(btn => {
                    btn.addEventListener('click', function() {
                        const id = parseInt(this.dataset.id);
                        const delta = parseInt(this.dataset.delta);
                        updateQuantity(id, delta);
                    });
                });
                body.querySelectorAll('.ci-remove').forEach(btn => {
                    btn.addEventListener('click', function() {
                        const id = parseInt(this.dataset.id);
                        removeFromCart(id);
                    });
                });

                btnCheckout.disabled = false;
                updateTotal();
                updateBadge();
            }

            // =================================================================
            // 6. TOAST
            // =================================================================
            function showToast(message, type = 'info') {
                const toast = document.createElement('div');
                toast.className = `toast ${type}`;
                const icon = type === 'success' ? '✅' : 'ℹ️';
                toast.innerHTML = `<span class="toast-icon">${icon}</span> ${message}`;
                toastContainer.appendChild(toast);
                setTimeout(() => {
                    toast.classList.add('hide');
                    setTimeout(() => toast.remove(), 400);
                }, 2800);
            }

            // =================================================================
            // 7. SIDEBAR CART — toggle
            // =================================================================
            function openCart() {
                cartSidebar.classList.add('open');
                cartOverlay.classList.add('open');
                document.body.style.overflow = 'hidden';
            }

            function closeCart() {
                cartSidebar.classList.remove('open');
                cartOverlay.classList.remove('open');
                document.body.style.overflow = '';
            }

            cartIcon.addEventListener('click', openCart);
            cartOverlay.addEventListener('click', closeCart);
            cartClose.addEventListener('click', closeCart);

            // =================================================================
            // 8. NAVIGASI & HAMBURGER
            // =================================================================
            hamburger.addEventListener('click', function() {
                mainNav.classList.toggle('open');
            });
            // Tutup nav saat link diklik (mobile)
            mainNav.querySelectorAll('a').forEach(link => {
                link.addEventListener('click', () => {
                    mainNav.classList.remove('open');
                });
            });

            // =================================================================
            // 9. PAYMENT — Spin Wheel
            // =================================================================
            const SEGMENTS = [
                { label: '0%', value: 0, color: '#F5E6D3' },
                { label: '5%', value: 5, color: '#E8D5C4' },
                { label: '10%', value: 10, color: '#D4A88C' },
                { label: '15%', value: 15, color: '#C49A7A' },
                { label: '20%', value: 20, color: '#B88A6A' },
                { label: '25%', value: 25, color: '#A87A5A' },
                { label: '30%', value: 30, color: '#986A4A' },
                { label: '50%', value: 50, color: '#FF8A5C' }
            ];
            const SEG_COUNT = SEGMENTS.length;
            const SEG_ANGLE = 360 / SEG_COUNT;

            let wheelCtx = null;

            function initWheel() {
                const canvas = wheelCanvas;
                const ctx = canvas.getContext('2d');
                wheelCtx = ctx;
                const w = canvas.width;
                const h = canvas.height;
                const cx = w / 2;
                const cy = h / 2;
                const radius = Math.min(w, h) / 2 - 6;

                ctx.clearRect(0, 0, w, h);

                // Gambar segmen
                for (let i = 0; i < SEG_COUNT; i++) {
                    const startAngle = (i * SEG_ANGLE - 90) * Math.PI / 180;
                    const endAngle = ((i + 1) * SEG_ANGLE - 90) * Math.PI / 180;

                    ctx.beginPath();
                    ctx.moveTo(cx, cy);
                    ctx.arc(cx, cy, radius, startAngle, endAngle);
                    ctx.closePath();
                    ctx.fillStyle = SEGMENTS[i].color;
                    ctx.fill();
                    ctx.strokeStyle = '#fff';
                    ctx.lineWidth = 2;
                    ctx.stroke();

                    // Teks di tengah segmen
                    const midAngle = (startAngle + endAngle) / 2;
                    const textR = radius * 0.62;
                    const tx = cx + Math.cos(midAngle) * textR;
                    const ty = cy + Math.sin(midAngle) * textR;

                    ctx.save();
                    ctx.translate(tx, ty);
                    ctx.rotate(midAngle + Math.PI / 2);
                    ctx.fillStyle = '#3D2B1F';
                    ctx.font = 'bold 18px Poppins, sans-serif';
                    ctx.textAlign = 'center';
                    ctx.textBaseline = 'middle';
                    ctx.fillText(SEGMENTS[i].label, 0, 0);
                    ctx.restore();
                }

                // Lingkaran tengah
                ctx.beginPath();
                ctx.arc(cx, cy, 26, 0, 2 * Math.PI);
                ctx.fillStyle = '#F5E6D3';
                ctx.fill();
                ctx.strokeStyle = '#6B4226';
                ctx.lineWidth = 2.5;
                ctx.stroke();
                ctx.fillStyle = '#6B4226';
                ctx.font = 'bold 14px Poppins, sans-serif';
                ctx.textAlign = 'center';
                ctx.textBaseline = 'middle';
                ctx.fillText('Luna', cx, cy);
            }

            // Gambar ulang wheel dengan rotasi
            function drawWheel(rotationDeg) {
                const canvas = wheelCanvas;
                const ctx = canvas.getContext('2d');
                const w = canvas.width;
                const h = canvas.height;
                const cx = w / 2;
                const cy = h / 2;
                const radius = Math.min(w, h) / 2 - 6;

                ctx.clearRect(0, 0, w, h);

                const rotRad = rotationDeg * Math.PI / 180;

                for (let i = 0; i < SEG_COUNT; i++) {
                    const startAngle = (i * SEG_ANGLE - 90) * Math.PI / 180 + rotRad;
                    const endAngle = ((i + 1) * SEG_ANGLE - 90) * Math.PI / 180 + rotRad;

                    ctx.beginPath();
                    ctx.moveTo(cx, cy);
                    ctx.arc(cx, cy, radius, startAngle, endAngle);
                    ctx.closePath();
                    ctx.fillStyle = SEGMENTS[i].color;
                    ctx.fill();
                    ctx.strokeStyle = '#fff';
                    ctx.lineWidth = 2;
                    ctx.stroke();

                    const midAngle = (startAngle + endAngle) / 2;
                    const textR = radius * 0.62;
                    const tx = cx + Math.cos(midAngle) * textR;
                    const ty = cy + Math.sin(midAngle) * textR;

                    ctx.save();
                    ctx.translate(tx, ty);
                    ctx.rotate(midAngle + Math.PI / 2);
                    ctx.fillStyle = '#3D2B1F';
                    ctx.font = 'bold 18px Poppins, sans-serif';
                    ctx.textAlign = 'center';
                    ctx.textBaseline = 'middle';
                    ctx.fillText(SEGMENTS[i].label, 0, 0);
                    ctx.restore();
                }

                ctx.beginPath();
                ctx.arc(cx, cy, 26, 0, 2 * Math.PI);
                ctx.fillStyle = '#F5E6D3';
                ctx.fill();
                ctx.strokeStyle = '#6B4226';
                ctx.lineWidth = 2.5;
                ctx.stroke();
                ctx.fillStyle = '#6B4226';
                ctx.font = 'bold 14px Poppins, sans-serif';
                ctx.textAlign = 'center';
                ctx.textBaseline = 'middle';
                ctx.fillText('Luna', cx, cy);
            }

            // Menentukan segmen di posisi pointer (atas = -90°)
            function getSegmentAtPointer(rotationDeg) {
                // Pointer di atas = -90° (atau 270°)
                // Normalisasi rotasi
                let rot = rotationDeg % 360;
                if (rot < 0) rot += 360;
                // Posisi pointer relatif terhadap rotasi
                const pointerAngle = 270; // derajat, di mana 0 = kanan, 90 = bawah, 180 = kiri, 270 = atas
                const effectiveAngle = (pointerAngle - rot + 360) % 360;
                const segIndex = Math.floor(effectiveAngle / SEG_ANGLE) % SEG_COUNT;
                return segIndex;
            }

            function spinWheel() {
                if (isSpinning) return;
                if (cart.length === 0) {
                    showToast('Keranjang kosong!', 'info');
                    return;
                }

                isSpinning = true;
                btnSpin.disabled = true;
                btnPay.disabled = true;
                discountDisplay.textContent = '...';

                // Pilih segmen acak
                const targetIndex = Math.floor(Math.random() * SEG_COUNT);
                // Hitung sudut target: agar segmen target berada di pointer (atas)
                // Pointer di 270°, segmen target berada di (targetIndex * SEG_ANGLE + SEG_ANGLE/2) 
                // Kita ingin segmen target berada di pointer
                const targetSegMid = targetIndex * SEG_ANGLE + SEG_ANGLE / 2;
                // Sudut yang diperlukan: pointerAngle - targetSegMid + n*360
                let targetAngle = 270 - targetSegMid;
                // Tambahkan putaran penuh (5-8 putaran)
                const extraSpins = 5 + Math.floor(Math.random() * 4);
                targetAngle += extraSpins * 360;
                // Pastikan rotasi selalu bertambah
                while (targetAngle <= wheelRotation) {
                    targetAngle += 360;
                }
                // Tambahkan sedikit randomness dalam segmen (± 8°)
                const jitter = (Math.random() - 0.5) * 12;
                targetAngle += jitter;

                // Animasi dengan requestAnimationFrame
                const startRot = wheelRotation;
                const endRot = targetAngle;
                const duration = 4000 + Math.random() * 600; // 4–4.6 detik
                const startTime = performance.now();

                function animateSpin(time) {
                    const elapsed = time - startTime;
                    const progress = Math.min(elapsed / duration, 1);
                    // Ease-out cubic
                    const ease = 1 - Math.pow(1 - progress, 3);
                    const currentRot = startRot + (endRot - startRot) * ease;
                    drawWheel(currentRot);

                    if (progress < 1) {
                        requestAnimationFrame(animateSpin);
                    } else {
                        wheelRotation = endRot;
                        // Tentukan segmen yang menang
                        const segIdx = getSegmentAtPointer(wheelRotation);
                        const seg = SEGMENTS[segIdx];
                        currentDiscount = seg.value;
                        discountDisplay.textContent = `${seg.value}%`;
                        discountDisplay.style.color = seg.value === 50 ? '#E05A3A' : 'var(--primary)';

                        // Update ringkasan
                        updatePaymentSummary();

                        isSpinning = false;
                        btnSpin.disabled = false;
                        btnPay.disabled = false;
                        showToast(`🎉 Diskon ${seg.value}% didapatkan!`, 'success');
                    }
                }
                requestAnimationFrame(animateSpin);
            }

            // =================================================================
            // 10. PAYMENT SUMMARY
            // =================================================================
            function updatePaymentSummary() {
                const total = getTotalPrice();
                const discAmount = Math.round(total * (currentDiscount / 100));
                const finalTotal = total - discAmount;

                let itemsHtml = '';
                cart.forEach(item => {
                    itemsHtml += `
                <div class="row">
                  <span>${item.name} × ${item.quantity}</span>
                  <span>Rp ${(item.price * item.quantity).toLocaleString('id-ID')}</span>
                </div>
              `;
                });

                pmSummary.innerHTML = `
              <div style="margin-bottom:6px; font-weight:600; color:var(--primary);">📋 Ringkasan Pesanan</div>
              ${itemsHtml}
              <div class="row">
                <span class="label">Total Awal</span>
                <span>Rp ${total.toLocaleString('id-ID')}</span>
              </div>
              <div class="row" style="color:#E05A3A; font-weight:600;">
                <span class="label">Diskon ${currentDiscount}%</span>
                <span>- Rp ${discAmount.toLocaleString('id-ID')}</span>
              </div>
              <div class="row total">
                <span>Total Bayar</span>
                <span>Rp ${finalTotal.toLocaleString('id-ID')}</span>
              </div>
            `;
            }

            // =================================================================
            // 11. BUKA PAYMENT MODAL
            // =================================================================
            function openPayment() {
                if (cart.length === 0) {
                    showToast('Keranjang kosong!', 'info');
                    return;
                }
                // Reset diskon
                currentDiscount = 0;
                discountDisplay.textContent = '—';
                discountDisplay.style.color = 'var(--primary)';
                btnPay.disabled = true;
                // Reset wheel ke posisi awal
                wheelRotation = 0;
                drawWheel(0);
                updatePaymentSummary();
                paymentModal.classList.add('open');
                document.body.style.overflow = 'hidden';
            }

            function closePayment() {
                paymentModal.classList.remove('open');
                document.body.style.overflow = '';
                // Hentikan spin jika sedang berjalan
                isSpinning = false;
                btnSpin.disabled = false;
            }

            btnCheckout.addEventListener('click', openPayment);
            pmClose.addEventListener('click', closePayment);
            // Klik overlay tutup modal
            paymentModal.addEventListener('click', function(e) {
                if (e.target === this) closePayment();
            });

            btnSpin.addEventListener('click', spinWheel);

            // =================================================================
            // 12. BAYAR / KONFIRMASI PESANAN
            // =================================================================
            btnPay.addEventListener('click', function() {
                if (cart.length === 0) {
                    showToast('Keranjang kosong!', 'info');
                    return;
                }
                if (currentDiscount === undefined || currentDiscount === null) {
                    showToast('Putar roda diskon terlebih dahulu!', 'info');
                    return;
                }

                // Generate nomor pesanan
                orderCounter += 1;
                localStorage.setItem('lunaOrderCounter', String(orderCounter));
                const orderId = `LUNA-${String(orderCounter).padStart(4, '0')}`;
                orderNumber.textContent = `#${orderId}`;

                // Simpan riwayat (opsional)
                const history = JSON.parse(localStorage.getItem('lunaOrderHistory') || '[]');
                history.push({
                    id: orderId,
                    items: cart.map(i => ({ name: i.name, qty: i.quantity, price: i.price })),
                    total: getTotalPrice(),
                    discount: currentDiscount,
                    finalTotal: getTotalPrice() - Math.round(getTotalPrice() * (currentDiscount / 100)),
                    date: new Date().toISOString()
                });
                localStorage.setItem('lunaOrderHistory', JSON.stringify(history));

                // Kosongkan keranjang
                cart = [];
                saveCart();
                renderCart();

                // Tutup payment, buka success
                closePayment();
                successModal.classList.add('open');
                document.body.style.overflow = 'hidden';

                showToast(`🎉 Pesanan #${orderId} berhasil!`, 'success');
            });

            // =================================================================
            // 13. SUCCESS MODAL
            // =================================================================
            btnSuccessClose.addEventListener('click', function() {
                successModal.classList.remove('open');
                document.body.style.overflow = '';
            });
            successModal.addEventListener('click', function(e) {
                if (e.target === this) {
                    successModal.classList.remove('open');
                    document.body.style.overflow = '';
                }
            });

            // =================================================================
            // 14. INIT
            // =================================================================
            function init() {
                renderProducts();
                loadCart();
                initWheel();
                drawWheel(0);
                updateBadge();
                // Cek apakah ada cart tersimpan
                if (cart.length > 0) {
                    renderCart();
                }
            }

            init();

            // =================================================================
            // 15. RESIZE — redraw wheel
            // =================================================================
            let resizeTimer;
            window.addEventListener('resize', function() {
                clearTimeout(resizeTimer);
                resizeTimer = setTimeout(() => {
                    if (!paymentModal.classList.contains('open')) {
                        // hanya redraw jika visible
                    }
                    drawWheel(wheelRotation);
                }, 300);
            });

            // Re-draw wheel saat modal dibuka (memastikan ukuran pas)
            const origOpen = openPayment;
            openPayment = function() {
                origOpen.call(this);
                setTimeout(() => {
                    drawWheel(wheelRotation);
                }, 100);
            };

            // =================================================================
            // 16. KEYBOARD SHORTCUT: ESC tutup modal / sidebar
            // =================================================================
            document.addEventListener('keydown', function(e) {
                if (e.key === 'Escape') {
                    if (successModal.classList.contains('open')) {
                        successModal.classList.remove('open');
                        document.body.style.overflow = '';
                    }
                    if (paymentModal.classList.contains('open')) {
                        closePayment();
                    }
                    if (cartSidebar.classList.contains('open')) {
                        closeCart();
                    }
                }
            });

            // =================================================================
            // 17. (Opsional) tampilkan riwayat pesanan di konsol
            // =================================================================
            console.log('🛍️ Luna Fashion siap!');
            console.log('📦 Pesanan tersimpan di localStorage.');

        })();
    </script>

</body>
</html>
