<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Luna Fashion — Toko Baju</title>

    <!-- Google Font: Poppins -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet" />

    <style>
        /* ===== RESET & VARIABLES ===== */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --primary: #6B4226;
            /* coklat tua */
            --primary-light: #8B6B4D;
            --secondary: #F5E6D3;
            /* krem */
            --accent: #E8A87C;
            /* oranye lembut */
            --accent-dark: #D49A6A;
            --bg: #FAF0E6;
            --white: #FFFFFF;
            --shadow: 0 8px 24px rgba(107, 66, 38, 0.12);
            --radius: 16px;
            --transition: 0.3s ease;
            --font: 'Poppins', sans-serif;
            --header-h: 72px;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: var(--font);
            background: var(--bg);
            color: #3D2B1F;
            line-height: 1.6;
            padding-top: var(--header-h);
        }

        a {
            text-decoration: none;
            color: inherit;
        }
        img {
            max-width: 100%;
            display: block;
        }
        button {
            cursor: pointer;
            font-family: var(--font);
            border: none;
            outline: none;
        }
        ul {
            list-style: none;
        }

        /* ===== SCROLLBAR ===== */
        ::-webkit-scrollbar {
            width: 6px;
        }
        ::-webkit-scrollbar-track {
            background: var(--secondary);
        }
        ::-webkit-scrollbar-thumb {
            background: var(--primary-light);
            border-radius: 10px;
        }

        /* ===== HEADER ===== */
        .header {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            height: var(--header-h);
            background: var(--white);
            box-shadow: 0 2px 12px rgba(0, 0, 0, 0.06);
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 2rem;
            z-index: 1000;
            border-bottom: 2px solid var(--secondary);
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 10px;
            font-weight: 700;
            font-size: 1.3rem;
            color: var(--primary);
        }
        .logo svg {
            width: 36px;
            height: 36px;
            fill: var(--primary);
        }

        .nav {
            display: flex;
            align-items: center;
            gap: 1.8rem;
        }
        .nav a {
            font-weight: 500;
            font-size: 0.95rem;
            color: #4A3728;
            transition: color var(--transition);
            position: relative;
        }
        .nav a:hover {
            color: var(--primary);
        }
        .nav a::after {
            content: '';
            position: absolute;
            bottom: -4px;
            left: 0;
            width: 0%;
            height: 2px;
            background: var(--accent);
            transition: width var(--transition);
        }
        .nav a:hover::after {
            width: 100%;
        }

        .cart-icon-wrap {
            position: relative;
            display: flex;
            align-items: center;
            gap: 4px;
            font-weight: 600;
            color: var(--primary);
            cursor: pointer;
            transition: color var(--transition);
        }
        .cart-icon-wrap:hover {
            color: var(--accent-dark);
        }
        .cart-badge {
            background: #E05A3A;
            color: #fff;
            font-size: 0.65rem;
            font-weight: 700;
            width: 20px;
            height: 20px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            position: absolute;
            top: -8px;
            right: -12px;
            box-shadow: 0 2px 6px rgba(224, 90, 58, 0.4);
            transition: transform 0.2s;
        }
        .cart-badge.pop {
            animation: pop 0.3s ease;
        }
        @keyframes pop {
            0% {
                transform: scale(1);
            }
            50% {
                transform: scale(1.5);
            }
            100% {
                transform: scale(1);
            }
        }

        .hamburger {
            display: none;
            flex-direction: column;
            gap: 4px;
            background: none;
            padding: 4px;
        }
        .hamburger span {
            display: block;
            width: 26px;
            height: 3px;
            background: var(--primary);
            border-radius: 4px;
            transition: var(--transition);
        }

        /* ===== HERO ===== */
        .hero {
            background: linear-gradient(135deg, var(--secondary) 0%, #EDDCCE 100%);
            padding: 3rem 2rem;
            text-align: center;
            border-bottom: 2px solid #E6D3C4;
        }
        .hero h1 {
            font-size: 2.6rem;
            font-weight: 700;
            color: var(--primary);
        }
        .hero p {
            font-size: 1.15rem;
            color: #5A4030;
            max-width: 560px;
            margin: 0.5rem auto 0;
        }

        /* ===== SECTION TITLE ===== */
        .section-title {
            text-align: center;
            font-size: 2rem;
            font-weight: 700;
            color: var(--primary);
            margin: 2.5rem 0 1.8rem;
            position: relative;
        }
        .section-title::after {
            content: '';
            display: block;
            width: 60px;
            height: 4px;
            background: var(--accent);
            margin: 8px auto 0;
            border-radius: 4px;
        }

        /* ===== PRODUCT GRID ===== */
        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 1.5rem;
        }

        .product-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
            gap: 2rem;
            padding-bottom: 2rem;
        }

        .product-card {
            background: var(--white);
            border-radius: var(--radius);
            overflow: hidden;
            box-shadow: var(--shadow);
            transition: transform var(--transition), box-shadow var(--transition);
            display: flex;
            flex-direction: column;
            border: 1px solid #F0E3D8;
        }
        .product-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 16px 40px rgba(107, 66, 38, 0.15);
        }
        .product-card .img-wrap {
            height: 220px;
            overflow: hidden;
            background: var(--secondary);
        }
        .product-card .img-wrap img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform var(--transition);
        }
        .product-card:hover .img-wrap img {
            transform: scale(1.04);
        }
        .product-card .info {
            padding: 1.2rem 1.2rem 1.4rem;
            flex: 1;
            display: flex;
            flex-direction: column;
        }
        .product-card .info h3 {
            font-size: 1.05rem;
            font-weight: 600;
            color: var(--primary);
            margin-bottom: 4px;
        }
        .product-card .info .desc {
            font-size: 0.85rem;
            color: #7A6A5A;
            margin-bottom: 10px;
            flex: 1;
        }
        .product-card .info .price {
            font-weight: 700;
            font-size: 1.15rem;
            color: var(--primary);
            margin-bottom: 12px;
        }
        .product-card .info .btn-add {
            background: var(--primary);
            color: #fff;
            padding: 10px 0;
            border-radius: 40px;
            font-weight: 600;
            font-size: 0.9rem;
            transition: background var(--transition), transform var(--transition);
            width: 100%;
            border: none;
        }
        .product-card .info .btn-add:hover {
            background: var(--primary-light);
            transform: scale(1.02);
        }
        .product-card .info .btn-add:active {
            transform: scale(0.96);
        }

        /* ===== CART SIDEBAR ===== */
        .cart-overlay {
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.35);
            z-index: 2000;
            opacity: 0;
            visibility: hidden;
            transition: opacity 0.35s, visibility 0.35s;
        }
        .cart-overlay.open {
            opacity: 1;
            visibility: visible;
        }

        .cart-sidebar {
            position: fixed;
            top: 0;
            right: -420px;
            width: 400px;
            max-width: 90vw;
            height: 100%;
            background: var(--white);
            z-index: 2001;
            box-shadow: -8px 0 32px rgba(0, 0, 0, 0.10);
            transition: right 0.4s cubic-bezier(0.22, 1, 0.36, 1);
            display: flex;
            flex-direction: column;
            padding: 0;
        }
        .cart-sidebar.open {
            right: 0;
        }

        .cart-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 1.2rem 1.5rem;
            border-bottom: 1px solid var(--secondary);
            flex-shrink: 0;
        }
        .cart-header h2 {
            font-size: 1.3rem;
            color: var(--primary);
        }
        .cart-close {
            background: none;
            font-size: 1.8rem;
            line-height: 1;
            color: #7A6A5A;
            transition: color var(--transition);
        }
        .cart-close:hover {
            color: var(--primary);
        }

        .cart-body {
            flex: 1;
            overflow-y: auto;
            padding: 1rem 1.5rem;
        }
        .cart-empty {
            text-align: center;
            color: #9A8A7A;
            padding: 3rem 0;
            font-size: 1rem;
        }
        .cart-empty span {
            font-size: 3rem;
            display: block;
            margin-bottom: 0.5rem;
        }

        .cart-item {
            display: flex;
            gap: 14px;
            padding: 12px 0;
            border-bottom: 1px solid #F0E8E0;
            align-items: center;
        }
        .cart-item .ci-img {
            width: 58px;
            height: 58px;
            border-radius: 8px;
            object-fit: cover;
            background: var(--secondary);
            flex-shrink: 0;
        }
        .cart-item .ci-info {
            flex: 1;
            min-width: 0;
        }
        .cart-item .ci-info .ci-name {
            font-weight: 600;
            font-size: 0.95rem;
            color: var(--primary);
        }
        .cart-item .ci-info .ci-price {
            font-size: 0.85rem;
            color: #7A6A5A;
        }
        .cart-item .ci-qty {
            display: flex;
            align-items: center;
            gap: 6px;
            margin-top: 4px;
        }
        .cart-item .ci-qty button {
            width: 28px;
            height: 28px;
            border-radius: 50%;
            background: var(--secondary);
            color: var(--primary);
            font-weight: 700;
            font-size: 1rem;
            transition: background var(--transition);
            display: flex;
            align-items: center;
            justify-content: center;
            border: none;
        }
        .cart-item .ci-qty button:hover {
            background: var(--accent);
        }
        .cart-item .ci-qty span {
            font-weight: 600;
            min-width: 28px;
            text-align: center;
        }
        .cart-item .ci-remove {
            background: none;
            color: #C0392B;
            font-size: 1.2rem;
            padding: 4px 8px;
            border-radius: 6px;
            transition: background var(--transition);
        }
        .cart-item .ci-remove:hover {
            background: #FDE8E5;
        }

        .cart-footer {
            border-top: 1px solid var(--secondary);
            padding: 1.2rem 1.5rem;
            flex-shrink: 0;
            background: var(--white);
        }
        .cart-footer .total-row {
            display: flex;
            justify-content: space-between;
            font-weight: 700;
            font-size: 1.15rem;
            color: var(--primary);
            margin-bottom: 12px;
        }
        .cart-footer .btn-checkout {
            width: 100%;
            padding: 14px 0;
            background: var(--primary);
            color: #fff;
            border-radius: 40px;
            font-weight: 700;
            font-size: 1rem;
            transition: background var(--transition), opacity var(--transition);
            border: none;
        }
        .cart-footer .btn-checkout:hover {
            background: var(--primary-light);
        }
        .cart-footer .btn-checkout:disabled {
            opacity: 0.4;
            cursor: not-allowed;
        }

        /* ===== PAYMENT MODAL (Spin Wheel) ===== */
        .payment-modal {
            position: fixed;
            inset: 0;
            z-index: 3000;
            background: rgba(0, 0, 0, 0.45);
            display: flex;
            align-items: center;
            justify-content: center;
            opacity: 0;
            visibility: hidden;
            transition: opacity 0.4s, visibility 0.4s;
            padding: 1.5rem;
        }
        .payment-modal.open {
            opacity: 1;
            visibility: visible;
        }

        .payment-box {
            background: var(--white);
            border-radius: var(--radius);
            max-width: 640px;
            width: 100%;
            max-height: 94vh;
            overflow-y: auto;
            padding: 2rem 2rem 2rem;
            box-shadow: 0 24px 64px rgba(0, 0, 0, 0.20);
            position: relative;
        }
        .payment-box .pm-close {
            position: absolute;
            top: 1rem;
            right: 1.2rem;
            background: none;
            font-size: 1.8rem;
            color: #7A6A5A;
            transition: color var(--transition);
        }
        .payment-box .pm-close:hover {
            color: var(--primary);
        }

        .pm-title {
            font-size: 1.4rem;
            font-weight: 700;
            color: var(--primary);
            margin-bottom: 0.25rem;
        }
        .pm-sub {
            color: #7A6A5A;
            font-size: 0.95rem;
            margin-bottom: 1.8rem;
        }

        /* Wheel container */
        .wheel-wrapper {
            display: flex;
            flex-direction: column;
            align-items: center;
            margin: 0 auto 1.5rem;
            position: relative;
        }
        .wheel-container {
            position: relative;
            width: 280px;
            height: 280px;
        }
        .wheel-container canvas {
            width: 100%;
            height: 100%;
            border-radius: 50%;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.15);
            transition: transform 4s cubic-bezier(0.17, 0.67, 0.12, 0.99);
            will-change: transform;
        }
        .wheel-container .pointer {
            position: absolute;
            top: -18px;
            left: 50%;
            transform: translateX(-50%);
            width: 0;
            height: 0;
            border-left: 18px solid transparent;
            border-right: 18px solid transparent;
            border-top: 30px solid #E05A3A;
            filter: drop-shadow(0 2px 6px rgba(224, 90, 58, 0.5));
            z-index: 10;
        }
        .wheel-container .pointer::after {
            content: '';
            position: absolute;
            top: -34px;
            left: 50%;
            transform: translateX(-50%);
            width: 16px;
            height: 16px;
            background: #E05A3A;
            border-radius: 50%;
        }

        .btn-spin {
            background: var(--accent);
            color: var(--primary);
            font-weight: 700;
            font-size: 1.1rem;
            padding: 12px 40px;
            border-radius: 40px;
            transition: background var(--transition), transform var(--transition);
            margin-top: 8px;
            border: none;
        }
        .btn-spin:hover {
            background: var(--accent-dark);
            transform: scale(1.04);
        }
        .btn-spin:disabled {
            opacity: 0.5;
            cursor: not-allowed;
            transform: none;
        }

        /* Discount result */
        .discount-result {
            text-align: center;
            padding: 1rem 0 0.5rem;
            font-size: 1rem;
        }
        .discount-result .big {
            font-size: 1.8rem;
            font-weight: 700;
            color: var(--primary);
        }
        .discount-result .big .highlight {
            color: #E05A3A;
        }

        /* Order summary in payment */
        .pm-summary {
            background: var(--secondary);
            border-radius: 12px;
            padding: 1rem 1.2rem;
            margin: 1rem 0 1.2rem;
        }
        .pm-summary .row {
            display: flex;
            justify-content: space-between;
            padding: 4px 0;
            font-size: 0.95rem;
        }
        .pm-summary .row.total {
            font-weight: 700;
            font-size: 1.1rem;
            border-top: 2px solid #D4C0B0;
            margin-top: 6px;
            padding-top: 10px;
            color: var(--primary);
        }
        .pm-summary .row .label {
            color: #5A4A3A;
        }

        .btn-pay {
            width: 100%;
            padding: 14px 0;
            background: #2D7D46;
            color: #fff;
            border-radius: 40px;
            font-weight: 700;
            font-size: 1.1rem;
            transition: background var(--transition);
            border: none;
        }
        .btn-pay:hover {
            background: #236A3A;
        }
        .btn-pay:disabled {
            opacity: 0.4;
            cursor: not-allowed;
        }

        /* ===== ORDER SUCCESS MODAL ===== */
        .success-modal {
            position: fixed;
            inset: 0;
            z-index: 4000;
            background: rgba(0, 0, 0, 0.45);
            display: flex;
            align-items: center;
            justify-content: center;
            opacity: 0;
            visibility: hidden;
            transition: opacity 0.4s, visibility 0.4s;
            padding: 1.5rem;
        }
        .success-modal.open {
            opacity: 1;
            visibility: visible;
        }

        .success-box {
            background: var(--white);
            border-radius: var(--radius);
            max-width: 460px;
            width: 100%;
            padding: 2.5rem 2rem;
            text-align: center;
            box-shadow: 0 24px 64px rgba(0, 0, 0, 0.20);
        }
        .success-box .icon {
            font-size: 4rem;
            margin-bottom: 0.5rem;
        }
        .success-box h2 {
            color: var(--primary);
            margin-bottom: 0.25rem;
        }
        .success-box p {
            color: #5A4A3A;
            margin: 0.5rem 0 1.2rem;
        }
        .success-box .order-number {
            background: var(--secondary);
            padding: 8px 16px;
            border-radius: 30px;
            display: inline-block;
            font-weight: 700;
            color: var(--primary);
            margin-bottom: 1.2rem;
            font-size: 1.1rem;
        }
        .success-box .btn-close-success {
            background: var(--primary);
            color: #fff;
            padding: 12px 40px;
            border-radius: 40px;
            font-weight: 600;
            transition: background var(--transition);
            border: none;
        }
        .success-box .btn-close-success:hover {
            background: var(--primary-light);
        }

        /* ===== ABOUT ===== */
        #tentang {
            background: var(--secondary);
            padding: 2.5rem 1.5rem;
            margin-top: 2rem;
            border-top: 2px solid #E6D3C4;
            border-bottom: 2px solid #E6D3C4;
        }
        #tentang .container {
            max-width: 720px;
            text-align: center;
        }
        #tentang h2 {
            color: var(--primary);
            margin-bottom: 0.5rem;
        }
        #tentang p {
            color: #5A4A3A;
        }

        /* ===== FOOTER ===== */
        .footer {
            background: var(--primary);
            color: #F5E6D3;
            padding: 2.5rem 1.5rem 1.8rem;
        }
        .footer .container {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 2rem;
            max-width: 1000px;
        }
        .footer h4 {
            font-weight: 600;
            margin-bottom: 0.6rem;
            color: #FFE8D0;
        }
        .footer p,
        .footer a {
            font-size: 0.9rem;
            color: #DCC8B8;
            line-height: 1.8;
        }
        .footer a {
            display: inline-block;
            margin-right: 1rem;
            transition: color var(--transition);
        }
        .footer a:hover {
            color: #fff;
        }
        .footer .bottom {
            grid-column: 1 / -1;
            text-align: center;
            border-top: 1px solid rgba(255, 255, 255, 0.10);
            padding-top: 1.5rem;
            margin-top: 0.5rem;
            font-size: 0.8rem;
            color: #B8A090;
        }

        /* ===== TOAST ===== */
        .toast-container {
            position: fixed;
            top: calc(var(--header-h) + 16px);
            right: 20px;
            z-index: 5000;
            display: flex;
            flex-direction: column;
            gap: 10px;
            max-width: 340px;
            width: 100%;
        }
        .toast {
            background: var(--primary);
            color: #fff;
            padding: 14px 20px;
            border-radius: 12px;
            box-shadow: 0 6px 20px rgba(0, 0, 0, 0.12);
            font-weight: 500;
            font-size: 0.9rem;
            animation: slideIn 0.4s ease forwards;
            display: flex;
            align-items: center;
            gap: 10px;
            border-left: 4px solid var(--accent);
        }
        .toast.success {
            border-left-color: #2D7D46;
        }
        .toast .toast-icon {
            font-size: 1.4rem;
        }
        @keyframes slideIn {
            0% {
                transform: translateX(40px);
                opacity: 0;
            }
            100% {
                transform: translateX(0);
                opacity: 1;
            }
        }
        .toast.hide {
            animation: slideOut 0.35s ease forwards;
        }
        @keyframes slideOut {
            0% {
                transform: translateX(0);
                opacity: 1;
            }
            100% {
                transform: translateX(40px);
                opacity: 0;
            }
        }

        /* ===== RESPONSIVE ===== */
        @media (max-width: 820px) {
            .header {
                padding: 0 1.2rem;
            }
            .nav a {
                font-size: 0.85rem;
            }
            .nav {
                gap: 1.2rem;
            }
            .hero h1 {
                font-size: 2rem;
            }
            .product-grid {
                grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
                gap: 1.2rem;
            }
        }

        @media (max-width: 640px) {
            :root {
                --header-h: 64px;
            }
            .nav {
                display: none;
                flex-direction: column;
                position: absolute;
                top: var(--header-h);
                left: 0;
                right: 0;
                background: var(--white);
                padding: 1.2rem 1.5rem;
                box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
                gap: 1rem;
                border-top: 1px solid var(--secondary);
            }
            .nav.open {
                display: flex;
            }
            .hamburger {
                display: flex;
            }
            .cart-sidebar {
                width: 100%;
                max-width: 100%;
                right: -100%;
            }
            .cart-sidebar.open {
                right: 0;
            }
            .wheel-container {
                width: 220px;
                height: 220px;
            }
            .payment-box {
                padding: 1.5rem;
            }
            .hero h1 {
                font-size: 1.6rem;
            }
            .hero {
                padding: 2rem 1rem;
            }
            .product-grid {
